#!/usr/bin/env bash
# =============================================================================
# .githooks/post-push
#
# 在 `git push` 之后自动触发 Skill 同步。
# 只在推送到 main / master 分支时才同步，dev 等开发分支推送不会触发。
#
# 安装方式：
#   cd /path/to/vibe-coding-learning
#   git config core.hooksPath .githooks
#
# 或者手动复制到 .git/hooks/：
#   cp .githooks/post-push .git/hooks/post-push
#   chmod +x .git/hooks/post-push
# =============================================================================

set -uo pipefail

# ── 颜色输出 ───────────────────────────────────────────────────────────────
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo ""
echo "=============================================="
echo "  🚀  Git Push 检测到"
echo "=============================================="
echo ""

# ── 获取脚本所在目录（即项目根目录） ────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

# ── 只在推送到 main 或 master 时才触发同步 ─────────────────────────────
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

if [[ "$CURRENT_BRANCH" != "main" && "$CURRENT_BRANCH" != "master" ]]; then
    echo -e "${BLUE}[INFO]${NC}  当前分支是 $CURRENT_BRANCH，跳过自动同步。"
    echo "  （只在 main/master 分支执行 push 后才会触发同步）"
    echo ""
    echo "=============================================="
    echo ""
    exit 0
fi

echo -e "${BLUE}[INFO]${NC}  当前分支: $CURRENT_BRANCH，开始同步 Skill..."
echo ""

# ── 调用同步脚本 ───────────────────────────────────────────────────────────
if [ -x "./sync-skills.sh" ]; then
    bash ./sync-skills.sh
    SYNC_EXIT=$?
else
    echo "  [WARN] sync-skills.sh 不可执行，尝试直接运行..."
    bash ./sync-skills.sh
    SYNC_EXIT=$?
fi

echo ""
if [ $SYNC_EXIT -eq 0 ]; then
    echo -e "${GREEN}  ✅ Skill 同步完成！${NC}"
    echo "  本地的 WorkBuddy / Claude / OpenClaw / Codex / Trae"
    echo "  已全部更新到最新版本。"
else
    echo -e "${YELLOW}  ⚠️  Skill 同步过程中出现警告（退出码 $SYNC_EXIT）${NC}"
    echo "  请检查 sync-config.json 中的路径配置是否正确。"
fi

echo ""
echo "=============================================="
echo ""

exit 0
